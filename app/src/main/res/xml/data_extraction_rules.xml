<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backup and device-transfer rules. -->
<data-extraction-rules>
    <cloud-backup>
        <!-- ADB identity private key: already paired TVs trust this key with no further prompt. -->
        <exclude domain="file" path="adbkeys/" />
        <!-- Per-install widget broadcast token. -->
        <exclude domain="file" path="widget_token" />
        <!-- TV screenshots and local crash diagnostics. -->
        <exclude domain="file" path="screenshots/" />
        <exclude domain="file" path="diagnostics/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="adbkeys/" />
        <exclude domain="file" path="widget_token" />
        <exclude domain="file" path="screenshots/" />
        <exclude domain="file" path="diagnostics/" />
    </device-transfer>
</data-extraction-rules>
