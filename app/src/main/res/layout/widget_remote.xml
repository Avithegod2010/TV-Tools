<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/w_open"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="TV Tools · Remote"
        android:textColor="#A5D6A7"
        android:textSize="12sp"
        android:textStyle="bold"
        android:paddingBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/w_power"
            style="@style/WidgetKey"
            android:text="⏻"
            android:textColor="#FF8A80" />

        <TextView
            android:id="@+id/w_up"
            style="@style/WidgetKey"
            android:text="▲" />

        <TextView
            android:id="@+id/w_back"
            style="@style/WidgetKey"
            android:text="←" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/w_left"
            style="@style/WidgetKey"
            android:text="◀" />

        <TextView
            android:id="@+id/w_ok"
            style="@style/WidgetKey"
            android:text="OK"
            android:textColor="#166D32"
            android:background="@drawable/widget_key_ok" />

        <TextView
            android:id="@+id/w_right"
            style="@style/WidgetKey"
            android:text="▶" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/w_home"
            style="@style/WidgetKey"
            android:text="⌂" />

        <TextView
            android:id="@+id/w_down"
            style="@style/WidgetKey"
            android:text="▼" />

        <TextView
            style="@style/WidgetKey"
            android:text=" "
            android:visibility="invisible" />
    </LinearLayout>
</LinearLayout>
