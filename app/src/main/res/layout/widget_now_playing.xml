<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/np_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_np_bg"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingTop="8dp"
    android:paddingEnd="10dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/np_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/now_playing_nothing"
            android:textColor="@color/widget_np_title"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/np_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/now_playing_open_remote"
            android:textColor="@color/widget_np_subtitle"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:baselineAligned="false"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/np_prev"
            android:layout_width="40dp"
            android:layout_height="28dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/widget_np_key"
            android:contentDescription="@string/media_previous"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="|◀"
            android:textColor="@color/widget_np_key_text"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/np_toggle"
            android:layout_width="44dp"
            android:layout_height="28dp"
            android:background="@drawable/widget_np_accent"
            android:contentDescription="@string/media_play"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="▶"
            android:textColor="@color/widget_np_on_accent"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/np_next"
            android:layout_width="40dp"
            android:layout_height="28dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_np_key"
            android:contentDescription="@string/media_next"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="▶|"
            android:textColor="@color/widget_np_key_text"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
