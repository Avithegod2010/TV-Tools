<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TvTools" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.TvTools.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0D5320</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.TvTools</item>
    </style>
</resources>
